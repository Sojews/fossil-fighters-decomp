// std::basic_string as the game's MSL C++ library lays it out. Only the parts the game code uses are declared;
// the out-of-line member functions are template instantiations kept once in the binary.
#ifndef MSL_STRING
#define MSL_STRING

#include <memory>
#include <algorithm>
#include <iterator>
#include <string.h>
#include <wstring.h>
#include <mem.h>
#include <msl_unk.hpp>

namespace std {

template <class T> struct char_traits {};
template <> struct char_traits<char> {
    static size_t length(const char *s) { return strlen(s); }
    static int compare(const char *a, const char *b, size_t n) { return memcmp(a, b, n); }
    static void assign(char &c, const char &value) { c = value; }
    static char *copy(char *dst, const char *src, size_t n) { return (char *)memcpy(dst, src, n); }
    static char *move(char *dst, const char *src, size_t n) { return (char *)memmove(dst, src, n); }
};
template <> struct char_traits<wchar_t> {
    static size_t length(const wchar_t *s) { return wcslen(s); }
    static int compare(const wchar_t *a, const wchar_t *b, size_t n) { return wmemcmp(a, b, n); }
    static void assign(wchar_t &c, const wchar_t &value) { c = value; }
    static wchar_t *copy(wchar_t *dst, const wchar_t *src, size_t n) { return wmemcpy(dst, src, n); }
    static wchar_t *move(wchar_t *dst, const wchar_t *src, size_t n) { return wmemmove(dst, src, n); }
};

template <class C, class Traits = char_traits<C>, class Alloc = allocator<C> >
class basic_string {
public:
    typedef unsigned long size_type;
    typedef C *iterator;
    // (A class around the pointer: the game passes these by value in memory.)
    class const_iterator {
    public:
        const_iterator(const C *p) : p_(p) {}
        operator const C *() const { return p_; }
        const C &operator*() const { return *p_; }
        const_iterator &operator++() {
            ++p_;
            return *this;
        }
        bool operator!=(const const_iterator &x) const { return p_ != x.p_; }
        bool operator==(const const_iterator &x) const { return p_ == x.p_; }

        const C *p_;
    };

    basic_string() {
        unsigned long i = 0;
        unsigned long *words = mWords;
        for (; i < 3; i++) {
            *words++ = 0;
        }
    }
    basic_string(const C *s);
    basic_string(const C *s, size_type n);
    basic_string(const basic_string &other);
    basic_string(const basic_string &str, size_type pos, size_type n, const Alloc &a = Alloc());
    // (The allocator is empty and sits at the start of the string.)
    const Alloc &get_allocator() const { return *(const Alloc *)this; }
    ~basic_string();

    void reserve(size_type n);
    basic_string &operator+=(const basic_string &str);
    basic_string &operator+=(const C *s);
    basic_string &operator=(const basic_string &str);
    basic_string &operator=(const C *s);

    static const size_type npos = (size_type)-1;

    basic_string substr(size_type pos = 0, size_type n = npos) const;
    size_type find(const C *s, size_type pos = 0) const;
    size_type find(const basic_string &str, size_type pos = 0) const;
    size_type find(const C *s, size_type pos, size_type n) const;
    size_type find(C c, size_type pos = 0) const;
    size_type find_first_not_of(const C *s, size_type pos = 0) const;
    size_type find_first_not_of(const C *s, size_type pos, size_type n) const;
    size_type find_last_not_of(const C *s, size_type pos = npos) const;
    size_type find_last_not_of(const C *s, size_type pos, size_type n) const;
    void push_back(C c);
    basic_string &replace(size_type pos, size_type n, const basic_string &str);
    basic_string &replace(size_type pos, size_type n, const C *s);
    basic_string &replace(size_type pos1, size_type n1, const basic_string &str, size_type pos2, size_type n2);
    size_type rfind(C c, size_type pos = npos) const;
    int compare(const C *s) const;
    int compare(const basic_string &str) const;
    int compare(size_type pos, size_type n1, const C *s, size_type n2) const;
    void swap(basic_string &str);

    void clear() {
        if (!is_long()) {
            mShort.buf[0] = 0;
            mShort.size = 0;
        } else {
            mLong.data[0] = 0;
            mLong.size = 0;
        }
    }

    bool is_long() const { return mLong.isLong; }
    size_type size() const { return !is_long() ? mShort.size : mLong.size; }
    bool empty() const { return size() == 0; }
    const C *data() const { return !is_long() ? mShort.buf : mLong.data; }
    const C *c_str() const { return data(); }
    C &operator[](size_type i) { return (!is_long() ? mShort.buf : mLong.data)[i]; }
    const_iterator begin() const { return !is_long() ? mShort.buf : mLong.data; }
    const_iterator end() const {
        const C *p;
        size_type n;
        if (!is_long()) {
            p = mShort.buf;
            n = mShort.size;
        } else {
            p = mLong.data;
            n = mLong.size;
        }
        return p + n;
    }

    const_iterator erase(const_iterator p);
    const_iterator insert(const_iterator p, C c);

    // Replaces [pos, pos + n) with [first, last) (the iterator tag picks the copy loop).
    basic_string &__replace(size_type pos, size_type n, const C *first, const C *last, random_access_iterator_tag);
    basic_string &assign(const C *first, const C *last);

    // Short strings are stored in place.
    union {
        unsigned long mWords[3];
        struct {
            unsigned long isLong : 1;
            unsigned long capacity : 31;
            size_type size;
            C *data;
        } mLong;
        struct {
            unsigned char isLong : 1;
            unsigned char size : 7;
            C buf[(12 - sizeof(C)) / sizeof(C)];
        } mShort;
    };
};

template <class C, class Traits, class Alloc>
bool operator==(const basic_string<C, Traits, Alloc> &lhs, const basic_string<C, Traits, Alloc> &rhs);

template <class C, class Traits, class Alloc>
inline bool operator<(const basic_string<C, Traits, Alloc> &lhs, const basic_string<C, Traits, Alloc> &rhs) {
    return lhs.compare(rhs) < 0;
}

template <class C, class Traits, class Alloc>
inline bool operator==(const basic_string<C, Traits, Alloc> &lhs, const C *rhs) {
    return lhs.compare(rhs) == 0;
}

// (Emitted wherever they are used.)
template <class C, class Traits, class Alloc>
typename basic_string<C, Traits, Alloc>::const_iterator basic_string<C, Traits, Alloc>::erase(const_iterator p) {
    __replace((const C *)p - data(), 1, 0, 0, random_access_iterator_tag());
    return p;
}

template <class C, class Traits, class Alloc>
typename basic_string<C, Traits, Alloc>::const_iterator basic_string<C, Traits, Alloc>::insert(const_iterator p, C c) {
    size_type pos = (const C *)p - data();
    __replace(pos, 0, &c, &c + 1, random_access_iterator_tag());
    return data() + pos;
}

template <class C, class Traits, class Alloc>
basic_string<C, Traits, Alloc> &basic_string<C, Traits, Alloc>::replace(size_type pos, size_type n, const C *s) {
    return __replace(pos, n, s, s + Traits::length(s), random_access_iterator_tag());
}

// Replaces the whole string with [first, last).
template <class C, class Traits, class Alloc>
basic_string<C, Traits, Alloc> &basic_string<C, Traits, Alloc>::assign(const C *first, const C *last) {
    return __replace(0, size(), first, last, random_access_iterator_tag());
}

template <class C, class Traits, class Alloc>
basic_string<C, Traits, Alloc> &basic_string<C, Traits, Alloc>::operator=(const C *s) {
    return replace(0, size(), s);
}

template <class C, class Traits, class Alloc>
basic_string<C, Traits, Alloc>::basic_string(const basic_string &str, size_type pos, size_type n, const Alloc &a) {
    unsigned long i = 0;
    unsigned long *words = mWords;
    for (; i < 3; i++) {
        *words++ = 0;
    }
    size_type size = str.size();
    reserve(pos <= size ? min(n, size - pos) : 0);
    replace(0, 0, str, pos, n);
}

template <class C, class Traits, class Alloc>
basic_string<C, Traits, Alloc> basic_string<C, Traits, Alloc>::substr(size_type pos, size_type n) const {
    return basic_string(*this, pos, n, get_allocator());
}

template <class C, class Traits, class Alloc>
basic_string<C, Traits, Alloc> &basic_string<C, Traits, Alloc>::replace(size_type pos1, size_type n1,
                                                                         const basic_string &str, size_type pos2,
                                                                         size_type n2) {
    const C *p;
    size_type size;
    if (!str.is_long()) {
        p = str.mShort.buf;
        size = str.mShort.size;
    } else {
        p = str.mLong.data;
        size = str.mLong.size;
    }
    if (pos2 > size) {
        printf("basic_string: out_of_range");
        abort();
    }
    p += pos2;
    n2 = min(n2, size - pos2);
    return __replace(pos1, n1, p, p + n2, random_access_iterator_tag());
}

template <class C, class Traits, class Alloc>
typename basic_string<C, Traits, Alloc>::size_type basic_string<C, Traits, Alloc>::find(C c, size_type pos) const {
    const C *p;
    size_type n;
    if (!is_long()) {
        p = mShort.buf;
        n = mShort.size;
    } else {
        p = mLong.data;
        n = mLong.size;
    }
    if (pos < n) {
        const C *end = p + n;
        for (const C *q = p + pos; q < end; q++) {
            if (c == *q) {
                return q - p;
            }
        }
    }
    return npos;
}

template <class C, class Traits, class Alloc>
typename basic_string<C, Traits, Alloc>::size_type basic_string<C, Traits, Alloc>::find(const C *s, size_type pos) const {
    return find(s, pos, Traits::length(s));
}

template <class C, class Traits, class Alloc>
typename basic_string<C, Traits, Alloc>::size_type basic_string<C, Traits, Alloc>::find(const C *s, size_type pos,
                                                                                        size_type n) const {
    const C *p;
    size_type size;
    if (!is_long()) {
        p = mShort.buf;
        size = mShort.size;
    } else {
        p = mLong.data;
        size = mLong.size;
    }
    if (pos <= size) {
        size_type remain = size - pos;
        const C *last = s + n;
        for (const C *q = p + pos; remain >= n; q++, remain--) {
            const C *b = q;
            const C *a = s;
            for (; a < last; a++, b++) {
                if (*a != *b) {
                    goto next;
                }
            }
            return q - p;
        next:;
        }
    }
    return npos;
}

template <class C, class Traits, class Alloc>
int basic_string<C, Traits, Alloc>::compare(size_type pos, size_type n1, const C *s, size_type n2) const {
    const C *p;
    size_type size;
    if (!is_long()) {
        p = mShort.buf;
        size = mShort.size;
    } else {
        p = mLong.data;
        size = mLong.size;
    }
    if (pos > size) {
        printf("string compare: pos > len");
        abort();
    }
    size_type rlen = min(size - pos, n1);
    int result = Traits::compare(p + pos, s, min(rlen, n2));
    if (result == 0) {
        if (rlen < n2) {
            return -1;
        }
        if (rlen != n2) {
            return 1;
        }
        return 0;
    }
    return result;
}

// The basic members, defined only where MSL_STRING_BASICS is (each file that emits one instantiates it).
#ifdef MSL_STRING_BASICS
template <class C, class Traits, class Alloc>
basic_string<C, Traits, Alloc>::basic_string(const C *s) {
    unsigned long i = 0;
    unsigned long *words = mWords;
    for (; i < 3; i++) {
        *words++ = 0;
    }
    size_type n = Traits::length(s);
    reserve(n);
    __replace(0, 0, s, s + n, random_access_iterator_tag());
}

template <class C, class Traits, class Alloc>
basic_string<C, Traits, Alloc>::~basic_string() {
    if (is_long()) {
        ::operator delete(mLong.data);
    }
}

// (Defined only in the files the game emits it in.)
#ifdef MSL_STRING_REPLACE_DEFINITION
// Replaces [pos, pos + n) with [first, last), growing onto the heap when it no longer fits. (A range from inside
// the string itself is copied out first.)
// NONMATCHING (both instances, ~99%): the game's TU pool puts the two terminator constants the other way round
// (char), and numbers the in-place path's registers differently (wchar_t).
template <class C, class Traits, class Alloc>
basic_string<C, Traits, Alloc> &basic_string<C, Traits, Alloc>::__replace(size_type pos, size_type n, const C *first,
                                                                          const C *last, random_access_iterator_tag) {
    bool wasLong = is_long();
    C *p;
    size_type size;
    size_type cap;
    if (!wasLong) {
        p = mShort.buf;
        size = mShort.size;
        cap = sizeof(mShort.buf) / sizeof(C);
    } else {
        p = mLong.data;
        size = mLong.size;
        cap = mLong.capacity;
    }
    if (pos > size) {
        printf("basic_string: out_of_range");
        abort();
    }
    size_type rlen = min(n, size - pos);
    size_type n2 = distance(first, last);
    size_type newSize;
    size_type tail;
    C *buf;
    size_type keep;
    C *dst;
    if (n2 > 0x7FFFFFFE || (keep = size - rlen) > 0x7FFFFFFE - n2) {
        printf("basic_string: length_error");
        abort();
    }
    newSize = n2 + keep;
    tail = size - (pos + rlen);
    if (newSize >= cap) {
        cap = (cap + 16 / sizeof(C) - 1) & ~(16 / sizeof(C) - 1);
        while (cap < newSize + 1) {
            cap = (cap * 2 + 16 / sizeof(C) - 1) & ~(16 / sizeof(C) - 1);
        }
        buf = (C *)::operator new(cap * sizeof(C));
        if (buf == 0) {
            printf("Memory allocation failure");
            abort();
        }
        if (pos != 0) {
            Traits::copy(buf, p, pos);
        }
        dst = buf + pos;
        memmove(dst, first, (last - first) * sizeof(C));
        if (tail != 0) {
            Traits::copy(dst + n2, p + pos + rlen, tail);
        }
        Traits::assign(buf[newSize], C());
        if (wasLong) {
            ::operator delete(p);
        } else {
            mLong.isLong = 1;
        }
        mLong.data = buf;
        mLong.size = newSize;
        mLong.capacity = cap;
    } else {
        basic_string copy;
        if (tail != 0 && p + pos + n2 < last && last <= p + size) {
            copy.assign(first, last);
            const basic_string &c = copy;
            first = c.data();
        }
        if (tail != 0) {
            Traits::move(p + pos + n2, p + pos + rlen, tail);
        }
        Traits::move(p + pos, first, n2);
        Traits::assign(p[newSize], C());
        if (!wasLong) {
            mShort.size = newSize;
        } else {
            mLong.size = newSize;
        }
    }
    return *this;
}
#endif

// Makes room for n characters (never fewer than it holds), moving between the in-place buffer and the heap.
template <class C, class Traits, class Alloc>
void basic_string<C, Traits, Alloc>::reserve(size_type n) {
    if (n > 0x7FFFFFFE) {
        printf("basic_string::reserve length_error");
        abort();
    }
    bool wasLong = is_long();
    size_type size;
    size_type cap;
    if (!wasLong) {
        size = mShort.size;
        cap = sizeof(mShort.buf) / sizeof(C);
    } else {
        cap = mLong.capacity;
        size = mLong.size;
    }
    if (n < size) {
        n = size;
    }
    if (n + 1 <= sizeof(mShort.buf) / sizeof(C)) {
        n = sizeof(mShort.buf) / sizeof(C);
    } else {
        n = (n + 16 / sizeof(C)) & ~(16 / sizeof(C) - 1);
    }
    if (n == cap) {
        return;
    }
    C *from;
    unsigned long toLong;
    C *to;
    if (n == sizeof(mShort.buf) / sizeof(C)) {
        to = mShort.buf;
        toLong = 0;
        from = mLong.data;
    } else {
        if (n > cap) {
            to = (C *)::operator new(n * sizeof(C));
            if (to == 0) {
                printf("Memory allocation failure");
                abort();
            }
        } else {
            to = (C *)::operator new(n * sizeof(C));
            if (to == 0) {
                printf("Memory allocation failure");
                abort();
            }
            if (to == 0) {
                return;
            }
        }
        toLong = 1;
        from = wasLong ? mLong.data : mShort.buf;
    }
    size_type len = (from + size) - from;
    memmove(to, from, len * sizeof(C));
    to[len] = 0;
    if (wasLong) {
        ::operator delete(from);
    }
    mLong.isLong = toLong;
    if (!toLong) {
        mShort.size = size;
    } else {
        mLong.data = to;
        mLong.size = size;
        mLong.capacity = n;
    }
}

template <class C, class Traits, class Alloc>
basic_string<C, Traits, Alloc>::basic_string(const basic_string &other) {
    if (!other.is_long()) {
        struct Rep {
            unsigned long words[3];
        };
        *(Rep *)mWords = *(const Rep *)other.mWords;
    } else {
        unsigned long i = 0;
        unsigned long *words = mWords;
        for (; i < 3; i++) {
            *words++ = 0;
        }
        reserve(other.mLong.size);
        __replace(0, 0, other.mLong.data, other.mLong.data + other.mLong.size, random_access_iterator_tag());
    }
}

template <class C, class Traits, class Alloc>
basic_string<C, Traits, Alloc> &basic_string<C, Traits, Alloc>::operator=(const basic_string &str) {
    bool isLong = is_long();
    if (!isLong && !str.is_long()) {
        struct Rep {
            unsigned long words[3];
        };
        *(Rep *)mWords = *(const Rep *)str.mWords;
        return *this;
    }
    return replace(0, isLong ? mLong.size : mShort.size, str);
}

template <class C, class Traits, class Alloc>
basic_string<C, Traits, Alloc> &basic_string<C, Traits, Alloc>::replace(size_type pos, size_type n,
                                                                         const basic_string &str) {
    const C *p;
    size_type size;
    if (!str.is_long()) {
        p = str.mShort.buf;
        size = str.mShort.size;
    } else {
        p = str.mLong.data;
        size = str.mLong.size;
    }
    return __replace(pos, n, p, p + size, random_access_iterator_tag());
}

template <class C, class Traits, class Alloc>
basic_string<C, Traits, Alloc> &basic_string<C, Traits, Alloc>::operator+=(const basic_string &str) {
    return replace(size(), 0, str);
}

template <class C, class Traits, class Alloc>
basic_string<C, Traits, Alloc> &basic_string<C, Traits, Alloc>::operator+=(const C *s) {
    return replace(size(), 0, s);
}
#endif

