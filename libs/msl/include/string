// std::basic_string as the game's MSL C++ library lays it out. Only the parts the game code uses are declared;
// the out-of-line member functions are template instantiations kept once in the binary.
#ifndef MSL_STRING
#define MSL_STRING

#include <memory>
#include <iterator>

namespace std {

template <class T> struct char_traits {};

template <class C, class Traits = char_traits<C>, class Alloc = allocator<C> >
class basic_string {
public:
    typedef unsigned long size_type;
    typedef C *iterator;
    // (A class around the pointer: the game passes these by value in memory.)
    class const_iterator {
    public:
        const_iterator(const C *p) : p_(p) {}
        operator const C *() const { return p_; }
        const C &operator*() const { return *p_; }
        const_iterator &operator++() {
            ++p_;
            return *this;
        }
        bool operator!=(const const_iterator &x) const { return p_ != x.p_; }
        bool operator==(const const_iterator &x) const { return p_ == x.p_; }

        const C *p_;
    };

    basic_string() {
        unsigned long i = 0;
        unsigned long *words = mWords;
        for (; i < 3; i++) {
            *words++ = 0;
        }
    }
    basic_string(const C *s);
    basic_string(const C *s, size_type n);
    basic_string(const basic_string &other);
    ~basic_string();

    void reserve(size_type n);
    basic_string &operator+=(const basic_string &str);
    basic_string &operator+=(const C *s);
    basic_string &operator=(const basic_string &str);
    basic_string &operator=(const C *s);

    static const size_type npos = (size_type)-1;

    basic_string substr(size_type pos = 0, size_type n = npos) const;
    size_type find(const C *s, size_type pos = 0) const;
    size_type find(C c, size_type pos = 0) const;
    size_type find_first_not_of(const C *s, size_type pos = 0) const;
    size_type find_first_not_of(const C *s, size_type pos, size_type n) const;
    size_type find_last_not_of(const C *s, size_type pos = npos) const;
    size_type find_last_not_of(const C *s, size_type pos, size_type n) const;
    void push_back(C c);
    size_type rfind(C c, size_type pos = npos) const;
    int compare(const C *s) const;
    int compare(const basic_string &str) const;
    int compare(size_type pos, size_type n1, const C *s, size_type n2) const;
    void swap(basic_string &str);

    void clear() {
        if (!is_long()) {
            mShort.buf[0] = 0;
            mShort.size = 0;
        } else {
            mLong.data[0] = 0;
            mLong.size = 0;
        }
    }

    bool is_long() const { return mLong.isLong; }
    size_type size() const { return !is_long() ? mShort.size : mLong.size; }
    bool empty() const { return size() == 0; }
    const C *data() const { return !is_long() ? mShort.buf : mLong.data; }
    const C *c_str() const { return data(); }
    C &operator[](size_type i) { return (!is_long() ? mShort.buf : mLong.data)[i]; }
    const_iterator begin() const { return !is_long() ? mShort.buf : mLong.data; }
    const_iterator end() const {
        const C *p;
        size_type n;
        if (!is_long()) {
            p = mShort.buf;
            n = mShort.size;
        } else {
            p = mLong.data;
            n = mLong.size;
        }
        return p + n;
    }

    // Replaces [pos, pos + n) with [first, last) (the iterator tag picks the copy loop).
    basic_string &__replace(size_type pos, size_type n, const C *first, const C *last, random_access_iterator_tag);

    // Short strings are stored in place.
    union {
        unsigned long mWords[3];
        struct {
            unsigned long isLong : 1;
            unsigned long capacity : 31;
            size_type size;
            C *data;
        } mLong;
        struct {
            unsigned char isLong : 1;
            unsigned char size : 7;
            C buf[(12 - sizeof(C)) / sizeof(C)];
        } mShort;
    };
};

template <class C, class Traits, class Alloc>
bool operator==(const basic_string<C, Traits, Alloc> &lhs, const basic_string<C, Traits, Alloc> &rhs);

template <class C, class Traits, class Alloc>
inline bool operator<(const basic_string<C, Traits, Alloc> &lhs, const basic_string<C, Traits, Alloc> &rhs) {
    return lhs.compare(rhs) < 0;
}

template <class C, class Traits, class Alloc>
inline bool operator==(const basic_string<C, Traits, Alloc> &lhs, const C *rhs) {
    return lhs.compare(rhs) == 0;
}

// The out-of-line members a file instantiates itself (defined only where MSL_STRING_DEFINITIONS is, so other
// files keep calling the copies they link against).
#ifdef MSL_STRING_DEFINITIONS
}  // namespace std
#include <string.h>
namespace std {


template <class C, class Traits, class Alloc>
basic_string<C, Traits, Alloc>::basic_string(const C *s, size_type n) {
    unsigned long i = 0;
    unsigned long *words = mWords;
    for (; i < 3; i++) {
        *words++ = 0;
    }
    reserve(n);
    __replace(0, 0, s, s + n, random_access_iterator_tag());
}

template <class C, class Traits, class Alloc>
void basic_string<C, Traits, Alloc>::swap(basic_string &str) {
    if (this != &str) {
        struct Rep {
            unsigned long words[3];
        };
        Rep tmp = *(Rep *) mWords;
        *(Rep *) mWords = *(Rep *) str.mWords;
        *(Rep *) str.mWords = tmp;
    }
}

template <class C, class Traits, class Alloc>
typename basic_string<C, Traits, Alloc>::size_type basic_string<C, Traits, Alloc>::rfind(C c, size_type pos) const {
    const C *p;
    size_type n;
    if (!is_long()) {
        p = mShort.buf;
        n = mShort.size;
    } else {
        p = mLong.data;
        n = mLong.size;
    }
    if (n != 0) {
        if (pos > n - 1) {
            pos = n - 1;
        }
        for (const C *q = p + pos;; q--) {
            if (c == *q) {
                return q - p;
            }
            if (q <= p) {
                break;
            }
        }
    }
    return npos;
}

template <class C, class Traits, class Alloc>
typename basic_string<C, Traits, Alloc>::size_type basic_string<C, Traits, Alloc>::find_first_not_of(const C *s,
                                                                                                size_type pos) const {
    return find_first_not_of(s, pos, strlen(s));
}

template <class C, class Traits, class Alloc>
typename basic_string<C, Traits, Alloc>::size_type
basic_string<C, Traits, Alloc>::find_first_not_of(const C *s, size_type pos, size_type n) const {
    const C *d;
    size_type sz;
    if (!is_long()) {
        d = mShort.buf;
        sz = mShort.size;
    } else {
        d = mLong.data;
        sz = mLong.size;
    }
    if (pos < sz) {
        if (n == 0) {
            return pos;
        }
        const C *e = d + sz;
        for (const C *p = d + pos; p < e; p++) {
            const C *q = s;
            for (size_type i = 0; i < n; i++, q++) {
                if (*p == *q) {
                    goto next_first;
                }
            }
            return p - d;
        next_first:;
        }
    }
    return npos;
}

template <class C, class Traits, class Alloc>
typename basic_string<C, Traits, Alloc>::size_type basic_string<C, Traits, Alloc>::find_last_not_of(const C *s,
                                                                                               size_type pos) const {
    return find_last_not_of(s, pos, strlen(s));
}

template <class C, class Traits, class Alloc>
typename basic_string<C, Traits, Alloc>::size_type
basic_string<C, Traits, Alloc>::find_last_not_of(const C *s, size_type pos, size_type n) const {
    const C *d;
    size_type sz;
    if (!is_long()) {
        d = mShort.buf;
        sz = mShort.size;
    } else {
        d = mLong.data;
        sz = mLong.size;
    }
    if (sz != 0) {
        if (pos > sz - 1) {
            pos = sz - 1;
        }
        for (const C *p = d + pos + 1; p > d;) {
            p--;
            const C *q = s;
            for (size_type i = 0; i < n; i++, q++) {
                if (*p == *q) {
                    goto next_last;
                }
            }
            return p - d;
        next_last:;
        }
    }
    return npos;
}

template <class C, class Traits, class Alloc>
int basic_string<C, Traits, Alloc>::compare(const basic_string &str) const {
    const C *s;
    size_type n;
    if (!str.is_long()) {
        s = str.mShort.buf;
        n = str.mShort.size;
    } else {
        s = str.mLong.data;
        n = str.mLong.size;
    }
    return compare(0, size(), s, n);
}

template <class C, class Traits, class Alloc>
bool operator==(const basic_string<C, Traits, Alloc> &lhs, const basic_string<C, Traits, Alloc> &rhs) {
    return lhs.size() == rhs.size() && lhs.compare(rhs) == 0;
}
#endif

typedef basic_string<char> string;
typedef basic_string<wchar_t> wstring;

string operator+(const char *lhs, const string &rhs);

template <class C, class Traits, class Alloc>
basic_string<C, Traits, Alloc> operator+(const basic_string<C, Traits, Alloc> &lhs, const C *rhs);

template <class C, class Traits, class Alloc>
basic_string<C, Traits, Alloc> operator+(const basic_string<C, Traits, Alloc> &lhs,
                                         const basic_string<C, Traits, Alloc> &rhs);

}  // namespace std

#endif
