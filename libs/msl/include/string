// std::string as the game's MSL C++ library lays it out. Only the parts the game code uses are declared; the
// member functions are defined out of line (they're template instantiations kept once in the binary).
#ifndef MSL_STRING
#define MSL_STRING

#include <memory>

namespace std {

template <class T> struct char_traits {};

template <class C, class Traits = char_traits<C>, class Alloc = allocator<C> >
class basic_string {
public:
    typedef unsigned long size_type;

    basic_string(const C *s);
    basic_string(const basic_string &other);
    ~basic_string();

    void reserve(size_type n);

    bool is_long() const { return mLong.isLong; }
    size_type size() const { return is_long() ? mLong.size : mShort.size; }
    const C *data() const { return is_long() ? mLong.data : mShort.buf; }
    const C *c_str() const { return data(); }

    // Strings of up to 10 characters are stored in place.
    union {
        struct {
            unsigned long isLong : 1;
            unsigned long capacity : 31;
            size_type size;
            C *data;
        } mLong;
        struct {
            unsigned char isLong : 1;
            unsigned char size : 7;
            C buf[11];
        } mShort;
    };
};

typedef basic_string<char> string;

string operator+(const char *lhs, const string &rhs);

}  // namespace std

#endif
