    template <typename T, typename Allocator> void __vec_deleter<T, Allocator>::reallocate_copy(size_t n) {
        __vec_deleter<T, Allocator> tmp;
        tmp.init();
        tmp.allocate(n);
        tmp.move_construct_to_end_tagged(begin(), end());
        optimize_after_moved_from();
        std::swap(cap(), tmp.cap());
        std::swap(data_, tmp.data_);
        std::swap(size_, tmp.size_);
    }

    template <typename T, typename Allocator> __vec_deleter<T, Allocator>::~__vec_deleter() {
        if (data_ != nullptr) {
            clear();
            typename remove_reference<Allocator>::type().deallocate(data_, cap());
        }
    }

    template <typename T, typename Allocator>
    void __vec_deleter<T, Allocator>::erase_at_end(size_t n, Metrowerks::int2type<false>) {
        T *e = end();
        size_ -= n;
        while (n != 0) {
            e--;
            e->~T();
            n--;
        }
    }

    template <typename T, typename Allocator> size_t __vec_deleter<T, Allocator>::grow_by(size_t n) {
        size_t max = max_size();
        size_t c   = cap();

        if (n > max - c) {
            __vector_common<true>::throw_length_error();
        }

        size_t a = max / 3;

        if (c < a) {
            return c + std::max((c + 1) * 3 / 5, n);
        } else if (c < a * 2) {
            return c + std::max((c + 1) / 2, n);
        }

        return max;
    }

    template <typename T, typename Allocator>
    void __vec_deleter<T, Allocator>::allocate(size_t n, Metrowerks::int2type<true> t) {
        size_t max = max_size();

        if (max < n) {
            __vector_common<true>::throw_length_error();
        }

        data_ = alloc().allocate(n);
        cap() = n;
    }

    // https://decomp.me/scratch/Yw4fn
    template <typename T, typename Allocator> void __vec_deleter<T, Allocator>::append_realloc(size_t n, const_reference x) {
        __vec_deleter_helper<T, typename remove_reference<Allocator>::type &> tmp(alloc_ref());

        size_t max = grow_by((size_ + n) - cap());
        tmp.allocate(size_ + n, max);
        tmp.start_ = size_;
        tmp.construct_at_end(n, x);
        tmp.move_construct_to_begin(begin(), end());
        optimize_after_moved_from();

        std::swap(cap(), tmp.cap());
        std::swap(data_, tmp.data_);
        std::swap(size_, tmp.size_);
    }

    template <typename T, typename Allocator>
    template <class It>
    void __vec_deleter<T, Allocator>::assign(It first, It last, Metrowerks::int2type<true>) {
        if (Metrowerks::has_trivial_copy_ctor<T>::value && Metrowerks::has_trivial_assignment<T>::value) {
            // Plain data: room for all of it, then one move.
            size_t n = last - first;
            size_t c = cap();
            if (n > c) {
                UnkMSLStruct1 unk = UnkMSLStruct1();
                reallocate_clear(n, grow_by(n - c));
            }
            copy_trivial(first, last, data_);
            size_ = n;
            return;
        }
        size_t n = last - first;
        size_t c = cap();
        if (n > c) {
            UnkMSLStruct1 unk = UnkMSLStruct1();
            reallocate_clear(n, grow_by(n - c));
            construct_range_at_end(first, last);
        } else {
            const T *mid = first + std::min(n, size_);
            T *d = data_;
            for (; first < mid; first++, d++) {
                *d = *first;
            }
            if (n < size_) {
                erase_at_end(size_ - n);
            } else if (size_ < n) {
                construct_range_at_end(mid, last);
            }
        }
    }

    template <typename T, typename Allocator> void __vec_deleter<T, Allocator>::reallocate_clear(size_t n, size_t max) {
        erase_at_end(size_);
        if (data_ != nullptr) {
            typename remove_reference<Allocator>::type().deallocate(data_, cap());
            data_ = nullptr;
            cap() = 0;
        }
        allocate(n, max);
    }

    template <typename T, typename Allocator>
    void __vec_deleter<T, Allocator>::append(size_t n, Metrowerks::int2type<true>) {
        if (n > cap() || size_ > cap() - n) {
            if (expand_by(size_ + n - cap())) {
                return;
            }
        } else {
            construct_n_at_end(n);
            return;
        }
        append_realloc(n);
    }

    template <typename T, typename Allocator> void __vec_deleter<T, Allocator>::append_realloc(size_t n) {
        __vec_deleter_helper<T, typename remove_reference<Allocator>::type &> tmp(alloc_ref());

        size_t max = grow_by((size_ + n) - cap());
        tmp.allocate(size_ + n, max);
        tmp.start_ = size_;
        tmp.construct_at_end(n);
        tmp.move_construct_to_begin(begin(), end());
        optimize_after_moved_from();

        std::swap(cap(), tmp.cap());
        std::swap(data_, tmp.data_);
        std::swap(size_, tmp.size_);
    }

    template <typename T, typename Allocator>
    void __vec_deleter<T, Allocator>::init_copy(const T *first, const T *last, Metrowerks::int2type<true>) {
        size_t n = last - first;
        if (n != 0) {
            allocate(n, Metrowerks::int2type<true>());
            UnkMSLStruct1 unk = UnkMSLStruct1();
            for (pointer p = data_ + size_; first != last; first++, p++, size_++) {
                alloc().construct(p, *first);
            }
        }
    }

    template <typename T, typename Allocator>
    void __vec_deleter<T, Allocator>::sub_push_back(const_reference x, Metrowerks::int2type<TAG_UNK>) {
        if (expand_by(1)) {
            size_++;
            back() = x;
        } else {
            append_realloc(1, x);
        }
    }

