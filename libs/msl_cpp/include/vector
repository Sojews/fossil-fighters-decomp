    template <typename T, class Allocator> class __vec_deleter_helper;

    // The capacity, with the (empty) allocator folded into it.
    template <class Allocator> struct __vec_capacity {
        size_t &first() {
            return cap;
        }
        const size_t &first() const {
            return cap;
        }
        // (The allocator is empty; the game keeps it in a compressed pair with the capacity.)
        Allocator &second() const {
            return *(Allocator *) this;
        }
        size_t cap;
    };

    // A temporary vector's capacity, with a reference to the allocator of the vector it's for.
    template <class Allocator> struct __vec_capacity<Allocator &> {
        size_t &first() {
            return cap;
        }
        const size_t &first() const {
            return cap;
        }
        Allocator &second() const {
            return *alloc;
        }
        size_t cap;
        Allocator *alloc;
    };

