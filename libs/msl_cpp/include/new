#ifndef _STD_NEW
#define _STD_NEW

#include <stddef.h>

// from rb3 decomp

namespace std {
    struct nothrow_t {};
    extern const nothrow_t nothrow;
}

// With exceptions on, these (and the predeclared deletes) say they throw nothing.
#if __option(exceptions)
#define _MSL_NO_THROW throw()
#else
#define _MSL_NO_THROW
#endif

void *operator new(size_t size);
void *operator new(size_t size, const std::nothrow_t &) _MSL_NO_THROW;
void *operator new[](size_t size, const std::nothrow_t &) _MSL_NO_THROW;
void *operator new[](size_t size);
void operator delete(void *ptr) _MSL_NO_THROW;
void operator delete[](void *ptr) _MSL_NO_THROW;

inline void *operator new(size_t length, void *ptr) {
#pragma unused(length)
    return ptr;
}

inline void *operator new[](size_t length, void *ptr) {
#pragma unused(length)
    return ptr;
}

inline void operator delete(void *ptr, void *place) {}

inline void operator delete[](void *ptr, void *place) {}

#endif // _STD_NEW
